#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @living_room_table.usd@
    ]
    upAxis = "Z"
)

over "World" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:physics = </World/ContactMaterial>

    def Material "ContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
        float physics:staticFriction = 0.5
    }

    over "Looks"
    {
        def Material "TacMindWalnut" (
            prepend references = @../table_maple/table_maple.usda@</Root/Looks/Walnut_Planks>
        )
        {
            over "Shader"
            {
                float2 inputs:texture_scale = (0.25, 0.75)
            }
        }
    }

