#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "power_socekt_medium"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "power_socekt_medium"
{
    def Scope "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </power_socekt_medium>
            rel physics:body1 = </power_socekt_medium/Geometry/power_socekt_medium>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "power_socekt_medium" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "power_socekt_medium_1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "sdf"
                uniform float physxSDFMeshCollision:sdfMargin = 0
                uniform float physxSDFMeshCollision:sdfNarrowBandThickness = 0.01
                uniform int physxSDFMeshCollision:sdfResolution = 256
            }
        }
    }
}
