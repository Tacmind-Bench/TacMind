#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "power_socekt_medium"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "power_socekt_medium"
{
    def Scope "Materials"
    {
        def Material "LightRed" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/LightRed>
        )
        {
        }
    }

    over "Geometry"
    {
        over "power_socekt_medium"
        {
            over "power_socekt_medium" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </power_socekt_medium/Materials/LightRed>
            }
        }
    }
}
