#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "industreal_rectangular_peg_16mm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "industreal_rectangular_peg_16mm"
{
    def Scope "Materials"
    {
        def Material "Blue" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/Blue>
        )
        {
        }
    }

    over "Geometry"
    {
        over "industreal_rectangular_peg_16mm"
        {
            over "industreal_rectangular_peg_16mm" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </industreal_rectangular_peg_16mm/Materials/Blue>
            }
        }
    }
}
