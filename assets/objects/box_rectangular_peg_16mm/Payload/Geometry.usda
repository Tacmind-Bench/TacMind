#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "industreal_rectangular_peg_16mm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "industreal_rectangular_peg_16mm"
{
    def Scope "Geometry"
    {
        def Xform "industreal_rectangular_peg_16mm"
        {
            def Mesh "industreal_rectangular_peg_16mm" (
                prepend references = @./GeometryLibrary.usdc@</Geometry/industreal_rectangular_peg_16mm>
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (2, 2, 2)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            }

            def Mesh "industreal_rectangular_peg_16mm_1" (
                displayName = "industreal_rectangular_peg_16mm"
                prepend references = @./GeometryLibrary.usdc@</Geometry/industreal_rectangular_peg_16mm>
            )
            {
                uniform token purpose = "guide"
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (2, 2, 2)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Scope "sdf"
                {
                    custom string urdf:resolution = "256"
                }
            }
        }
    }
}
