#usda 1.0
(
    defaultPrim = "industreal_rectangular_peg_16mm"
    metersPerUnit = 1
    subLayers = [
        @box_rectangular_peg_16mm.usd@
    ]
    upAxis = "Z"
)

over "industreal_rectangular_peg_16mm"
{
    over "Physics"
    {
        over "root_joint" (
            active = false
        )
        {
        }
    }

    over "Geometry"
    {
        over "industreal_rectangular_peg_16mm" (
            prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.035
            bool physics:rigidBodyEnabled = 1

            over "industreal_rectangular_peg_16mm_1" (
                apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysxSDFMeshCollisionAPI"]
            )
            {
                rel material:binding:physics = </industreal_rectangular_peg_16mm/BlindContactMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                uniform token physics:approximation = "sdf"
                bool physics:collisionEnabled = 1
                custom float physxCollision:contactOffset = 0.0005
                custom float physxCollision:restOffset = 0
                uniform float physxSDFMeshCollision:sdfMargin = 0
                uniform float physxSDFMeshCollision:sdfNarrowBandThickness = 0.01
                uniform int physxSDFMeshCollision:sdfResolution = 512
                token visibility = "invisible"
            }
        }
    }

    def Material "BlindContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.48
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }
}

