#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "classification_ball"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "classification_ball"
{
    def Scope "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </classification_ball>
            rel physics:body1 = </classification_ball/Geometry/ball>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "ball" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "ball_task_tabletennis_1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }
        }
    }
}
