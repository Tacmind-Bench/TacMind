#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    defaultPrim = "classification_ball"
    subLayers = [
        @ball_class_blank.usd@
    ]
)

over "classification_ball"
{
    over "Physics"
    {
        over "root_joint" (
            active = false
        )
        {
        }
    }

    over "Geometry"
    {
        over "ball" (
            prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.046
            bool physics:rigidBodyEnabled = 1

            over "ball_task_tabletennis_1" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
                token visibility = "invisible"
            }

            def Sphere "collision_sphere" (
                apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                token visibility = "invisible"
                double radius = 0.0197
                double3 xformOp:translate = (0, -0.0544, 0.0197)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                rel material:binding:physics = </classification_ball/BlindContactMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.0005
                custom float physxCollision:restOffset = 0
            }
        }
    }

    def Material "BlindContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.48
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }
}
