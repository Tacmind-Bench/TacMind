#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "box_search"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "box_search"
{
    def Scope "Materials"
    {
        def Material "CardboardYellow" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/CardboardYellow>
        )
        {
        }
    }

    over "Geometry"
    {
        over "box"
        {
            over "box1_update2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </box_search/Materials/CardboardYellow>
            }
        }
    }
}
