#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "USB_plug"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "USB_plug"
{
    def Scope "Materials"
    {
        def Material "Blue" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/Blue>
        )
        {
        }
    }

    over "Geometry"
    {
        over "USB_plug"
        {
            over "USB_plug" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </USB_plug/Materials/Blue>
            }
        }
    }
}
