#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "USB_plug"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "USB_plug"
{
    def Scope "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </USB_plug>
            rel physics:body1 = </USB_plug/Geometry/USB_plug>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "USB_plug" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "USB_plug_1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }
        }
    }
}
