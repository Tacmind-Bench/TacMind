#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "pingpong_ball"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pingpong_ball"
{
    def Scope "Geometry"
    {
        def Xform "pingpong_ball"
        {
            def Mesh "sphere" (
                prepend references = @./GeometryLibrary.usdc@</Geometry/sphere>
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Mesh "sphere_1" (
                displayName = "sphere"
                prepend references = @./GeometryLibrary.usdc@</Geometry/sphere>
            )
            {
                uniform token purpose = "guide"
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Scope "sdf"
                {
                    custom string urdf:resolution = "256"
                }
            }
        }
    }
}
