#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "pingpong_ball"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pingpong_ball"
{
    def Scope "Materials"
    {
        def Material "white" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/white>
        )
        {
        }
    }

    over "Geometry"
    {
        over "pingpong_ball"
        {
            over "sphere" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </pingpong_ball/Materials/white>
            }
        }
    }
}
