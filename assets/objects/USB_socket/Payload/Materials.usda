#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "USB_socket"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "USB_socket"
{
    def Scope "Materials"
    {
        def Material "LightRed" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/LightRed>
        )
        {
        }
    }

    over "Geometry"
    {
        over "USB_socket"
        {
            over "USB_socket_1port" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </USB_socket/Materials/LightRed>
            }
        }
    }
}
