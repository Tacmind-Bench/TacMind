#usda 1.0
(
    defaultPrim = "USB_socket"
    metersPerUnit = 1
    subLayers = [@USB_socket.usd@]
    upAxis = "Z"
)

over "USB_socket" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    over "Physics"
    {
        over "root_joint" (
            active = false
        )
        {
        }
    }

    rel material:binding:physics = </USB_socket/ContactMaterial>

    def Material "ContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.5
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0
    }

    over "Geometry"
    {
        over "USB_socket"
        {
            bool physics:kinematicEnabled = true
        }
    }
}
