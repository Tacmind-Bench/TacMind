#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "box_insert"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "box_insert"
{
    def Scope "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body0 = </box_insert>
            rel physics:body1 = </box_insert/Geometry/box>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "box" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "box_socket_big_update7_1"
            {
                over "tn__001_y4ya4k3Y3" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                )
                {
                    bool physics:collisionEnabled = 0
                    uniform token physics:approximation = "convexHull"
                }

                over "industreal_tray_pick_rectangular_peg_16mm" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysxSDFMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "sdf"
                    uniform float physxSDFMeshCollision:sdfMargin = 0
                    uniform float physxSDFMeshCollision:sdfNarrowBandThickness = 0.01
                    uniform int physxSDFMeshCollision:sdfResolution = 256
                }
            }
        }
    }
}
