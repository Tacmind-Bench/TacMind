#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "box_insert"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "box_insert"
{
    def Scope "Geometry"
    {
        def Xform "box"
        {
            def Xform "box_socket_big_update7" (
                prepend references = @./GeometryLibrary.usdc@</Geometry/box_socket_big_update7>
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "box_socket_big_update7_1" (
                displayName = "box_socket_big_update7"
                prepend references = @./GeometryLibrary.usdc@</Geometry/box_socket_big_update7>
            )
            {
                uniform token purpose = "guide"
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Scope "sdf"
                {
                    custom string urdf:resolution = "128"
                }
            }
        }
    }
}
