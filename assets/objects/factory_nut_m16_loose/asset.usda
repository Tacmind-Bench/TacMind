#usda 1.0
(
    defaultPrim = "factory_nut_m16_loose"
    metersPerUnit = 1
    subLayers = [
        @factory_nut_m16_loose.usd@
    ]
    upAxis = "Z"
)

over "factory_nut_m16_loose" (
    delete apiSchemas = ["PhysicsArticulationRootAPI"]
    prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.03
    bool physics:rigidBodyEnabled = 1

    over "factory_nut" (
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        over "visuals" (
            instanceable = false
        )
        {
            over "mesh_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
            }
        }

        over "collisions" (
            instanceable = false
        )
        {
            over "mesh_0" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
            }
        }
    }

    def Material "BlindContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.48
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }

    def Xform "DetailedCollision" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./collision.usda@
    )
    {
        rel material:binding:physics = </factory_nut_m16_loose/BlindContactMaterial>
    }
}
