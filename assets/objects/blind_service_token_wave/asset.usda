#usda 1.0
(
    defaultPrim = "blind_service_token_wave"
    metersPerUnit = 1
    subLayers = [@blind_service_token_wave.usd@]
    upAxis = "Z"
)

over "blind_service_token_wave"
{
    over "PhysicsMaterials"
    {
        over "DefaultContact"
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.6
        }
    }
}
