#usda 1.0
(
    defaultPrim = "HDMISlot_low"
    metersPerUnit = 1
    subLayers = [
        @hdmi_slot.usd@
    ]
    upAxis = "Z"
)

over "HDMISlot_low" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:density = 5000
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 1

    over "mesh" (
        delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
    )
    {
    }

    def Xform "SlotCollision" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </HDMISlot_low/PhysicsMaterial>
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.2
        float physics:restitution = 0
        float physics:staticFriction = 0.25
        uniform token physxMaterial:frictionCombineMode = "min"
        uniform token physxMaterial:restitutionCombineMode = "min"
    }

    def Xform "DetailedCollision" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @./collision.usda@
    )
    {
        rel material:binding:physics = </HDMISlot_low/PhysicsMaterial>
    }
}
