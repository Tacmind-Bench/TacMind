#usda 1.0
(
    defaultPrim = "blind_fuse_axial_ribs"
    metersPerUnit = 1
    subLayers = [@blind_fuse_axial_ribs.usd@]
    upAxis = "Z"
)

over "blind_fuse_axial_ribs"
{
    over "PhysicsMaterials"
    {
        over "DefaultContact"
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.6
        }
    }
}
