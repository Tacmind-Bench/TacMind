#usda 1.0
(
    defaultPrim = "golf_ball"
    metersPerUnit = 1
    subLayers = [
        @ball_class_golf.usd@
    ]
    upAxis = "Z"
)

over "golf_ball"
{
    over "Physics"
    {
        over "root_joint" (
            active = false
        )
        {
        }
    }

    over "Geometry"
    {
        over "golf_ball" (
            prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 0
            float physics:mass = 0.046
            bool physics:rigidBodyEnabled = 1

            over "ball_task_golf_1" (
                delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
                token visibility = "invisible"
            }

            # Disabled collision shapes still contribute to PhysX mass properties.
            over "tactile_grasp_proxy" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysxCollisionAPI"]
                delete apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                rel material:binding:physics = </golf_ball/BlindContactMaterial> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                bool physics:collisionEnabled = 0
                double radius = 0.0197
                token visibility = "invisible"
            }

            def Xform "DetailedCollision" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @./collision.usda@
            )
            {
                rel material:binding:physics = </golf_ball/BlindContactMaterial>
            }
        }
    }

    def Material "BlindContactMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.48
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }
}
