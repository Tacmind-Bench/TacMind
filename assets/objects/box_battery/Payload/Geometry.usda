#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.0"
    }
    defaultPrim = "battery"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "battery"
{
    def Scope "Geometry"
    {
        def Xform "battery"
        {
            def Mesh "battery" (
                prepend references = @./GeometryLibrary.usdc@</Geometry/battery>
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.4, 0.4, 0.4)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Mesh "battery_1" (
                displayName = "battery"
                prepend references = @./GeometryLibrary.usdc@</Geometry/battery>
            )
            {
                uniform token purpose = "guide"
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.4, 0.4, 0.4)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Scope "sdf"
                {
                    custom string urdf:resolution = "64"
                }
            }
        }
    }
}
