            over "Lights"
            {
                over "Light"
                {
                    custom float inputs:exposure = 4
                    custom float inputs:intensity = 9000000
                    custom bool inputs:normalize = 0
                    custom float inputs:radius = 0.5
                    custom float inputs:shaping:cone:angle = 120
                    custom float inputs:shaping:cone:softness = 0
