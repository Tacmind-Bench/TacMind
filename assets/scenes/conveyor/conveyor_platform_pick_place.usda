#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [@conveyor_pick_place.usda@]
    upAxis = "Z"
)

over "World"
{
    def Scope "BeltPlatformLooks"
    {
        def Material "PlatformMaterial"
        {
            token outputs:surface.connect = </World/BeltPlatformLooks/PlatformMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.72, 0.03)
                color3f inputs:emissiveColor = (0.08, 0.035, 0.0)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }
    }

    def Cube "BeltTaskPlatform" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/BeltPlatformLooks/PlatformMaterial>
        bool physics:collisionEnabled = 1
        bool physics:kinematicEnabled = 1
        bool physics:rigidBodyEnabled = 1
        double size = 1
        double3 xformOp:scale = (0.1248, 0.1368, 0.02)
        double3 xformOp:translate = (50, 0, 2.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
