    def Cube "motion_commander_target" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.005, -0.005, -0.005), (0.005, 0.005, 0.005)]
        rel material:binding = </World/Looks/visual_material> (
            bindMaterialAs = "strongerThanDescendants"
        )
        double size = 0.01
        token visibility = "inherited"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "Looks"
    {
        def Material "visual_material"
        {
            token outputs:surface.connect = </World/Looks/visual_material/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float3 inputs:diffuseColor = (0.15, 0.15, 0.15)
                token outputs:surface
            }
        }
    }
